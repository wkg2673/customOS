<Project Sdk="Cosmos.Sdk/3.0.97">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <CosmosEnableStorage>true</CosmosEnableStorage>
    <CosmosEnableNetwork>true</CosmosEnableNetwork>
    <CosmosEnableGraphics>true</CosmosEnableGraphics>
    <CosmosEnableKeyboard>true</CosmosEnableKeyboard>
    <CosmosEnableMouse>true</CosmosEnableMouse>
  </PropertyGroup>

  <!-- Core kernel packages -->
  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" Version="3.0.97" />
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.97" />
  </ItemGroup>
</Project>
